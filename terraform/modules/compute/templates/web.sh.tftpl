#!/bin/bash
# Web server bootstrap. The instance has no public IP, so a successful package
# install is itself proof that egress through the NAT Gateway works.
set -euo pipefail

cat > /etc/ssh/sshd_config.d/90-securevpc.conf <<'CONF'
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitRootLogin no
AllowAgentForwarding no
AllowTcpForwarding no
X11Forwarding no
MaxAuthTries 3
LoginGraceTime 30
CONF
systemctl restart sshd

dnf -y install httpd

# Same page as the original console-built project.
echo "<h1>Secure Web Server</h1>" > /var/www/html/index.html
echo "<!-- ${name} -->" >> /var/www/html/index.html

systemctl enable --now httpd
